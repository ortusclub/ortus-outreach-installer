# Google Sheets write-back URL — DO NOT SET.
# v2.52.0+: centralized in src/sheets-webapp-url.js. Every operator's app
# POSTs to the same Apps Script deployment (Antonio's). Setting this
# variable here will be IGNORED by the code.
# SHEETS_WEBAPP_URL=  (no longer used)

# State of Operations sheet — DO NOT SET.
# v2.52.0+: centralized in src/sheets-webapp-url.js. Setting these here
# will be IGNORED by the code.
# SOO_SHEET_ID=    (no longer used)
# SOO_SHEET_GID=   (no longer used)

# Operations Log + Campaign Activity Apps Script web app URLs — DO NOT SET.
# v2.56.0+: centralized in src/sheets-webapp-url.js. Every operator's app
# now posts to the same team-wide log sheets (Antonio's deployments) so
# Sam + colleagues' usage shows up alongside Antonio's. Setting these
# here will be IGNORED by the code.
# OPS_LOG_WEBAPP_URL=        (no longer used)
# CAMPAIGN_LOG_WEBAPP_URL=   (no longer used)

# Comma-separated emails that bypass the SoO allowlist (dev / emergency access).
# Listed emails can sign in even when the SoO sheet is unreachable or unconfigured.
# SOO_BYPASS_EMAILS=

# Dashboard basic auth credentials
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_to_a_strong_password

# Server port (default 3000)
PORT=3000

# (Optional) Custom Chrome/Chromium path -- auto-detected if not set
# CHROME_PATH=/path/to/chrome

# Resource-aware campaign (Phase 11.1)
# RAM_THROTTLE_PCT=90
# RAM_RELEASE_PCT=80
# CPU_THROTTLE_LOAD_FACTOR=0.9
# CPU_RELEASE_LOAD_FACTOR=0.7
# THROTTLE_MULTIPLIER=2
# PARK_PAGE=about:blank
# IDLE_PARKING_ENABLED=true

# Batch-mode campaign (Phase 11.2)
# PROFILE_CLOSE_GAP_MIN — between batches, if the derived wait exceeds this
# many minutes, the profile is closed entirely (S3-commits the session) and
# re-opened next batch. Otherwise the browser is kept alive and parked on
# about:blank. Default: 15.
# PROFILE_CLOSE_GAP_MIN=15

# Sales Nav Scrape engine (control-panel → GKE)
# The "Sales Nav Scrape" campaign type does NOT scrape locally — it dispatches
# to the GKE scraper engine. Point this at the engine's base URL; the app reads
# it via src/scraper-client.js. Leave blank to keep the scrape mode disabled.
# SCRAPER_ENGINE_URL=https://scraper.ortusclub.com
# SCRAPER_ENGINE_TOKEN=   (bearer token for the engine's auth, if required)

# Concurrency cap (2.8.25)
# Maximum number of GoLogin browser profiles that can be open simultaneously.
# If you select more accounts than this, the extras queue and rotate in as
# slots free up (a profile closes at batch end when others are waiting).
# Default 3 — keeps RAM use under ~1.5 GB on 8 GB machines.
# Lower for weak hosts; raise for 16 GB+.
# MAX_CONCURRENT_PROFILES=3
