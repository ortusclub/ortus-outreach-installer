# GoLogin API token -- get from https://app.gologin.com/ > API settings
GOLOGIN_API_TOKEN=your_token_here

# Google Sheets write-back URL (Apps Script web app deployment URL)
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Dashboard basic auth credentials
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_to_a_strong_password

# Server port (default 3000)
PORT=3000
